# SafeSOC — Environment Variable Reference
#
# Copy the relevant section into backend/.env (SafeSOC backend) and/or
# cloud/AWS-IAM-backend/.env (CloudLens). Values below are the code's own
# defaults (from backend/app/core/config.py) unless marked otherwise —
# replace secrets before deploying anywhere real.
#
# [ACTIVE] tags mean: read by code that actually runs today. As of
# Milestone 14 (SS-068), every setting below is active — see
# docs/architecture.md / docs/requirements.md for feature-by-feature detail.


# ════════════════════════════════════════════════════
# SafeSOC Backend  →  backend/.env
# ════════════════════════════════════════════════════

# ── Application [ACTIVE] ────────────────────────────
APP_NAME=SafeSOC
APP_VERSION=1.0.0
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
API_PREFIX=/api/v1

# ── OpenSearch [ACTIVE] ──────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_ILM_RETENTION_DAYS=90

# ── PostgreSQL [ACTIVE] ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safesoc
POSTGRES_USER=safesoc
POSTGRES_PASSWORD=safesoc

# ── Redis [ACTIVE] ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT Authentication [ACTIVE] ──────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Auth Rate Limiting [ACTIVE] ──────────────────────
# Redis-backed fixed-window limits on POST /api/v1/auth/login (keyed by
# tenant_id+email) and /register (keyed by client IP) — see
# docs/security-review.md.
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT_ATTEMPTS=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=300

# ── Threat Intelligence APIs [ACTIVE] ────────────────
VT_API_KEY=
ABUSEIPDB_API_KEY=
VT_RATE_LIMIT_PER_MINUTE=4
ABUSEIPDB_RATE_LIMIT_PER_DAY=1000
TI_CACHE_CLEAN_TTL=86400
TI_CACHE_MALICIOUS_TTL=604800

# ── LLM Configuration [ACTIVE] ───────────────────────
LLM_PROVIDER=ollama
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768

# ── NL Investigation Assistant [ACTIVE] ──────────────
INVESTIGATION_SESSION_TTL_SECONDS=600
INVESTIGATION_LLM_TIMEOUT_SECONDS=10

# ── Correlation Engine [ACTIVE] ──────────────────────
CORRELATION_WINDOW_TTL=3600
CORRELATION_CONFIDENCE_THRESHOLD=0.6

# ── Risk Scoring [ACTIVE] ────────────────────────────
RISK_SCORE_CRITICAL=40
RISK_SCORE_HIGH=20
RISK_SCORE_MEDIUM=10
RISK_SCORE_LOW=5
RISK_SCORE_TI_MALICIOUS_BONUS=30
RISK_SCORE_ANOMALY_BONUS=15
RISK_SCORE_AFTER_HOURS_BONUS=10
RISK_SCORE_MITRE_BONUS=20
RISK_TIME_DECAY_PER_HOUR=0.04
RISK_RECALC_INTERVAL_MINUTES=15
RISK_RECALC_LOOKBACK_HOURS=24

# ── Anomaly Detection [ACTIVE] ───────────────────────
ANOMALY_THRESHOLD=0.7
ANOMALY_MODEL_PATH=
NETWORK_ANOMALY_ZSCORE_THRESHOLD=3.0

# ── Reporting [ACTIVE] ───────────────────────────────
REPORT_OUTPUT_DIR=
REPORT_SCHEDULE_DAY=0
REPORT_SCHEDULE_HOUR=6

# ── Ingestion [ACTIVE — INGEST_RATE_LIMIT_PER_MINUTE is defined but
#    not currently enforced anywhere; INGEST_BATCH_SIZE is enforced
#    as a hard cap since SS-005] ──
INGEST_BATCH_SIZE=500
INGEST_RATE_LIMIT_PER_MINUTE=1000

# ── CORS [ACTIVE] ────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── CloudLens Integration [ACTIVE] ──────────────────
# Shared secret checked against the X-Service-Token header on
# POST /api/v1/cloud/findings (SS-039). Must match SAFESOC_SERVICE_TOKEN
# below exactly — same secret, one side sends it, the other checks it.
CLOUDLENS_SERVICE_TOKEN=

# ── Notifications [ACTIVE] ───────────────────────────
# SafeSOC's own Telegram bot (SS-055) — separate from the CloudLens
# backend's own TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID below, which is a
# different application/deployment. Notifications no-op silently
# (not an error) if either of these is unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ════════════════════════════════════════════════════
# CloudLens Backend  →  cloud/AWS-IAM-backend/.env
# ════════════════════════════════════════════════════

# ── Django [ACTIVE] ──────────────────────────────────
# Falls back to a dev-only default in cloud/AWS-IAM-backend/iam_project/settings.py
# if unset — set a real value before deploying anywhere shared.
SECRET_KEY=django-insecure-dev-key-change-this-in-prod

# ── Telegram notifications [ACTIVE] ─────────────────
# Read by cloud/AWS-IAM-backend/engine/notifier.py. If either is unset,
# the scan still runs — the notifier just logs a message and skips sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SafeSOC sync [ACTIVE] ────────────────────────────
# Read by cloud/AWS-IAM-backend/engine/safesoc_bridge.py (SS-039). If any
# of these are unset, the scan still runs — the bridge just logs a
# message and skips syncing, same as the Telegram notifier above.
SAFESOC_API_URL=http://localhost:8000
SAFESOC_SERVICE_TOKEN=
SAFESOC_TENANT_ID=

# Note: AWS credentials for CloudLens are supplied per-scan through the
# "Connect Account" screen in the frontend, not via environment variables.
