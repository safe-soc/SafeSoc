# SafeSOC — Environment Variable Reference
#
# Copy the relevant section into backend/.env (SafeSOC backend) and/or
# cloud/AWS-IAM-backend/.env (CloudLens). Values below are the code's own
# defaults (from backend/app/core/config.py) unless marked otherwise —
# replace secrets before deploying anywhere real.
#
# Status tags:
#   [ACTIVE]  read by code that actually runs today
#   [PHASE 2] defined in config, not yet consumed by any running code
#   (see docs/architecture.md / docs/requirements.md for details)


# ════════════════════════════════════════════════════
# SafeSOC Backend  →  backend/.env
# ════════════════════════════════════════════════════

# ── Application [ACTIVE] ────────────────────────────
APP_NAME=SafeSOC
APP_VERSION=1.0.0
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
API_PREFIX=/api/v1

# ── OpenSearch [ACTIVE] ──────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# ── PostgreSQL [PHASE 2 — no driver installed, no models yet] ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safesoc
POSTGRES_USER=safesoc
POSTGRES_PASSWORD=safesoc

# ── Redis [PHASE 2 — no client installed yet] ───────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT Authentication [PHASE 2 — no auth endpoints yet] ──
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Threat Intelligence APIs [PHASE 2 — clients unimplemented] ──
VT_API_KEY=
ABUSEIPDB_API_KEY=
VT_RATE_LIMIT_PER_MINUTE=4
ABUSEIPDB_RATE_LIMIT_PER_DAY=1000
TI_CACHE_CLEAN_TTL=86400
TI_CACHE_MALICIOUS_TTL=604800

# ── LLM Configuration [PHASE 2 — NL assistant unimplemented] ──
LLM_PROVIDER=ollama
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral:7b
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768

# ── Correlation Engine [PHASE 2] ────────────────────
CORRELATION_WINDOW_TTL=3600
CORRELATION_CONFIDENCE_THRESHOLD=0.6

# ── Risk Scoring [PHASE 2] ──────────────────────────
RISK_SCORE_CRITICAL=40
RISK_SCORE_HIGH=20
RISK_SCORE_MEDIUM=10
RISK_SCORE_LOW=5
RISK_SCORE_TI_MALICIOUS_BONUS=30
RISK_SCORE_ANOMALY_BONUS=15
RISK_SCORE_AFTER_HOURS_BONUS=10
RISK_SCORE_MITRE_BONUS=20
RISK_TIME_DECAY_PER_HOUR=0.04

# ── Anomaly Detection [PHASE 2 — no trained model] ──
ANOMALY_THRESHOLD=0.7
NETWORK_ANOMALY_ZSCORE_THRESHOLD=3.0

# ── Reporting [PHASE 2 — no report generation code] ──
REPORT_SCHEDULE_DAY=0
REPORT_SCHEDULE_HOUR=6

# ── Ingestion [ACTIVE — INGEST_BATCH_SIZE is defined but not
#    currently enforced as a hard cap by the ingest endpoint] ──
INGEST_BATCH_SIZE=500
INGEST_RATE_LIMIT_PER_MINUTE=1000

# ── CORS [ACTIVE] ────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]


# ════════════════════════════════════════════════════
# CloudLens Backend  →  cloud/AWS-IAM-backend/.env
# ════════════════════════════════════════════════════

# ── Django [ACTIVE] ──────────────────────────────────
# Falls back to a dev-only default in cloud/AWS-IAM-backend/iam_project/settings.py
# if unset — set a real value before deploying anywhere shared.
SECRET_KEY=django-insecure-dev-key-change-this-in-prod

# ── Telegram notifications [ACTIVE] ─────────────────
# Read by cloud/AWS-IAM-backend/engine/notifier.py. If either is unset,
# the scan still runs — the notifier just logs a message and skips sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Note: AWS credentials for CloudLens are supplied per-scan through the
# "Connect Account" screen in the frontend, not via environment variables.
