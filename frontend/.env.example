# SafeSOC backend base URL — the default matches `docker compose up` / `uvicorn` locally.
VITE_API_BASE_URL=http://localhost:8000

# SafeSOC backend WebSocket URL (SS-063, GET /ws) — same host as
# VITE_API_BASE_URL, ws:// instead of http:// (wss:// in production over TLS).
VITE_WS_BASE_URL=ws://localhost:8000
