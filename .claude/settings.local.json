      "Bash(curl -s -w '\\\\nHTTP %{http_code}\\\\n' -X POST http://127.0.0.1:8000/api/v1/ingest -H 'Content-Type: application/json' -d '{\"tenant_id\":\"test\",\"logs\":[{\"tenant_id\":\"test\",\"source\":\"synthetic\",\"log_type\":\"authentication\",\"timestamp\":\"2026-08-05T02:47:11Z\",\"host_id\":\"H1\",\"host_ip\":\"10.0.0.1\",\"action\":\"failed_login\",\"description\":\"test\",\"severity\":\"low\"}]}')"
    ]
  }
